<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\GDM\Core\**\*.cs" />
    <Compile Include="..\..\src\GDM\Integration\Installer.Core.cs" />
    <Compile Include="..\..\src\GDM\Integration\Updater.Core.cs" />
    <Compile Include="..\..\src\GDM\Integration\Cli.Core.cs" />
    <Compile Include="..\..\src\GDM\Integration\**\*.cs" Exclude="..\..\src\GDM\Integration\*.Core.cs" />
    <EmbeddedResource Include="..\..\src\GDM\i18n\*.json" LogicalName="i18n/%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="..\..\src\GDM\Integration\Remote\remote.html" LogicalName="Remote/remote.html" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
  </ItemGroup>

</Project>
