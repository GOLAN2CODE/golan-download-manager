<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GDM</AssemblyName>
    <RootNamespace>Golan.Gdm</RootNamespace>
    <StartupObject>Golan.Gdm.Program</StartupObject>
    <ApplicationIcon>Assets\gdm.ico</ApplicationIcon>
    <Version>2.5.1</Version>
    <Product>Golan Download Manager</Product>
    <Company>Golan</Company>
    <Authors>Golan</Authors>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="i18n\*.json" LogicalName="i18n/%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="Integration\Remote\remote.html" LogicalName="Remote/remote.html" />
    <Resource Include="Assets\gdm.ico" />
    <Resource Include="Assets\gdm.png" />
    <Resource Include="Assets\gdm-logo-full.png" />
    <EmbeddedResource Include="..\..\extension\**\*.*" Exclude="..\..\extension\tests\**" LogicalName="ext/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
  </ItemGroup>

</Project>
