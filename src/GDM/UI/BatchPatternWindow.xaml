<Window x:Class="Golan.Gdm.UI.BatchPatternWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Golan.Gdm.Core"
        Title="{core:T win.batchpattern.title}" Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" Style="{StaticResource GdmWindow}" Icon="/Assets/gdm.ico">
    <StackPanel Margin="20">
        <TextBlock Text="{core:T win.batchpattern.header}" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="{core:T win.batchpattern.hint}" Margin="0,8,0,12"
                   Foreground="{DynamicResource Muted}"/>
        <TextBox x:Name="PatternBox" FlowDirection="LeftToRight" Tag="{core:T win.batchpattern.pattern_tag}"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <RadioButton x:Name="NumbersRadio" Content="{core:T win.batchpattern.numbers}" IsChecked="True"/>
            <RadioButton x:Name="LettersRadio" Content="{core:T win.batchpattern.letters}" Margin="18,0,0,0"/>
        </StackPanel>
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{core:T win.batchpattern.from}" Style="{StaticResource Label}"/>
                <TextBox x:Name="FromBox" FlowDirection="LeftToRight" Text="1"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0">
                <TextBlock Text="{core:T win.batchpattern.to}" Style="{StaticResource Label}"/>
                <TextBox x:Name="ToBox" FlowDirection="LeftToRight" Text="10"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{core:T win.batchpattern.pad}" Style="{StaticResource Label}"/>
                <TextBox x:Name="WidthBox" FlowDirection="LeftToRight" Text="0"/>
            </StackPanel>
        </Grid>
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="LoginBox" FlowDirection="LeftToRight" Tag="{core:T win.batchpattern.login_tag}"/>
            <PasswordBox x:Name="PasswordBox" Grid.Column="1" Margin="8,0,0,0"/>
        </Grid>
        <TextBlock Text="{core:T win.batchpattern.preview_label}" Style="{StaticResource Label}" Margin="0,12,0,4"/>
        <TextBlock x:Name="PreviewText" TextWrapping="Wrap" MaxHeight="90"/>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="{core:T win.batchpattern.ok}" Style="{StaticResource Primary}" IsDefault="True" Click="Ok_Click"/>
            <Button Content="{core:T win.batchpattern.cancel}" IsCancel="True" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
