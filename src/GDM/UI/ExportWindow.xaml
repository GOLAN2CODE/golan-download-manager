<Window x:Class="Golan.Gdm.UI.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Golan.Gdm.Core"
        Title="{core:T win.export.title}" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" Style="{StaticResource GdmWindow}" Icon="/Assets/gdm.ico">
    <StackPanel Margin="20">
        <TextBlock Text="{core:T win.export.header}" FontSize="17" FontWeight="SemiBold"/>
        <RadioButton x:Name="QueueRadio" Margin="0,14,0,0"/>
        <RadioButton x:Name="SelectedRadio"/>
        <RadioButton x:Name="AllRadio" Content="{core:T win.export.all}" IsChecked="True"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="{core:T win.export.ok}" Style="{StaticResource Primary}" IsDefault="True" Click="Ok_Click"/>
            <Button Content="{core:T win.export.cancel}" IsCancel="True" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
