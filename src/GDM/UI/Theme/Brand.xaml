<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Golan Brand Core Tokens (sampled from design/gdm-logo-source.webp) -->
    <Color x:Key="BrandYellowColor">#FDD103</Color>
    <Color x:Key="BrandYellowHoverColor">#F5C400</Color>
    <Color x:Key="BrandYellowPressedColor">#E0B100</Color>
    <Color x:Key="BrandInkColor">#131313</Color>
    <Color x:Key="QrQuietZoneColor">#FFFFFF</Color>

    <SolidColorBrush x:Key="BrandYellow" Color="#FDD103"/>
    <SolidColorBrush x:Key="BrandYellowHover" Color="#F5C400"/>
    <SolidColorBrush x:Key="BrandYellowPressed" Color="#E0B100"/>
    <SolidColorBrush x:Key="BrandInk" Color="#131313"/>
    <SolidColorBrush x:Key="AccentInk" Color="#131313"/>
    <SolidColorBrush x:Key="QrQuietZone" Color="#FFFFFF"/>

    <!-- Consistent Apple-grade Corner Radii -->
    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>
</ResourceDictionary>
