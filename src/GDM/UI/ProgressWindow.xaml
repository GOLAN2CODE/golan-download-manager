<Window x:Class="Golan.Gdm.UI.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Golan.Gdm.UI"
        xmlns:core="clr-namespace:Golan.Gdm.Core"
        xmlns:v3="clr-namespace:Golan.Gdm.Core"
        Title="{core:T main.progress.title}" Width="650" Height="610" MinWidth="560"
        WindowStartupLocation="CenterScreen" Style="{StaticResource GdmWindow}" Icon="/Assets/gdm.ico">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl x:Name="Tabs">
            <TabItem Header="{core:T main.progress.tabStatus}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0">
                        <DockPanel>
                            <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource AccentSoft}">
                                <TextBlock x:Name="Glyph" FontFamily="{StaticResource IconFont}" FontSize="21"
                                           Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="NameText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="UrlText" FontSize="11.5" Foreground="{DynamicResource Muted}"
                                           TextWrapping="Wrap" FlowDirection="LeftToRight"/>
                                <TextBlock x:Name="SaveToText" FontSize="11.5" Foreground="{DynamicResource Muted}"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock x:Name="PercentText" DockPanel.Dock="Left" FontSize="28" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentText}" FlowDirection="LeftToRight"/>
                                    <TextBlock x:Name="StatusText" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                               Margin="0,0,0,6" Foreground="{DynamicResource Muted}"/>
                                </DockPanel>
                                <ProgressBar x:Name="Bar" Maximum="100" Height="10" Margin="0,8,0,0"/>
                                <UniformGrid Columns="4" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{core:T main.progress.size}" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="SizeText" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{core:T main.progress.downloaded}" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="DoneText" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{core:T main.progress.speed}" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="SpeedText" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{core:T main.progress.eta}" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="EtaText" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <Border x:Name="SegmentsCard" Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock x:Name="ConnText" DockPanel.Dock="Left" Foreground="{DynamicResource Muted}"/>
                                    <TextBlock x:Name="ResumeText" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <ui:SegmentBar x:Name="Segments" Height="16" Margin="0,8,0,0"/>
                                <DataGrid x:Name="ConnectionsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" HeadersVisibility="Column" Height="150" Margin="0,12,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{core:T main.progress.colNum}" Binding="{Binding Number}" Width="45"/>
                                        <DataGridTextColumn Header="{core:T main.progress.colDownloaded}" Binding="{Binding Downloaded}" Width="110"/>
                                        <DataGridTextColumn Header="{core:T main.progress.colStatus}" Binding="{Binding Info}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button x:Name="DetailsButton" Content="{core:T main.progress.hideDetails}" HorizontalAlignment="Left"
                                        Margin="0,8,0,0" Click="Details_Click"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="TorrentCard" Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="{v3:T torrent.progress.sectionTitle}" FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <Button x:Name="TorrentFilesBtn" Content="{v3:T torrent.progress.filesButton}" HorizontalAlignment="Right"
                                            Click="TorrentFiles_Click"/>
                                </DockPanel>
                                <UniformGrid Columns="4" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{v3:T torrent.progress.seeds}" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="TorrentSeedsText" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{v3:T torrent.progress.peers}" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="TorrentPeersText" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{v3:T torrent.progress.ratio}" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="TorrentRatioText" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{v3:T torrent.progress.uploadSpeed}" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="TorrentUploadText" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </UniformGrid>
                                <DataGrid x:Name="TorrentFilesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" HeadersVisibility="Column" Height="130" Margin="0,12,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{v3:T torrent.files.col.path}" Binding="{Binding Path}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="{core:T main.progress.size}" Binding="{Binding SizeText}" Width="110"/>
                                        <DataGridTextColumn Header="{core:T main.progress.colStatus}" Binding="{Binding ProgressText}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap"
                                   Margin="2,10,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{core:T main.progress.tabLimiter}">
                <StackPanel Margin="0,16,0,0">
                    <CheckBox x:Name="SpeedLimitEnabled" Content="{core:T main.progress.enableLimit}"
                              Checked="SpeedLimitChanged" Unchecked="SpeedLimitChanged"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="{core:T main.progress.limitLabel}" VerticalAlignment="Center"/>
                        <TextBox x:Name="SpeedLimitBox" Width="100" Margin="8,0,4,0" FlowDirection="LeftToRight"
                                 AutomationProperties.Name="{core:T main.progress.limitAria}" TextChanged="SpeedLimitTextChanged"/>
                        <TextBlock Text="{core:T main.progress.limitUnit}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <CheckBox x:Name="RememberSpeedLimit" Content="{core:T main.progress.rememberLimit}"
                              Margin="0,12,0,0" Checked="OptionsChanged" Unchecked="OptionsChanged"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="{core:T main.progress.tabOnDone}">
                <StackPanel Margin="0,16,0,0">
                    <CheckBox x:Name="OnDoneShowDialog" Content="{core:T main.progress.showCompleteDialog}"
                              Checked="OptionsChanged" Unchecked="OptionsChanged"/>
                    <CheckBox x:Name="OnDoneExit" Content="{core:T main.progress.exitWhenDone}" Margin="0,10,0,0"
                              Checked="OptionsChanged" Unchecked="OptionsChanged"/>
                    <CheckBox x:Name="OnDoneShutdown" Content="{core:T main.progress.shutdownWhenDone}" Margin="0,10,0,0"
                              Checked="OptionsChanged" Unchecked="OptionsChanged"/>
                    <CheckBox x:Name="OnDoneForce" Content="{core:T main.progress.forceShutdown}" Margin="0,10,0,0"
                              Checked="OptionsChanged" Unchecked="OptionsChanged"/>
                </StackPanel>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="1">
            <DockPanel Margin="0,16,0,0" LastChildFill="False">
                <Button x:Name="PauseBtn" DockPanel.Dock="Left" Style="{StaticResource Primary}" MinWidth="110" Click="Pause_Click"/>
                <Button x:Name="OpenBtn" DockPanel.Dock="Left" Content="{core:T main.progress.openFile}" Margin="8,0,0,0"
                        Click="Open_Click" Visibility="Collapsed"/>
                <Button x:Name="FolderBtn" DockPanel.Dock="Left" Content="{core:T main.progress.openFolder}" Margin="8,0,0,0" Click="Folder_Click"/>
                <Button x:Name="CancelBtn" DockPanel.Dock="Left" Content="{core:T main.progress.cancelDownload}" Margin="8,0,0,0" Click="Cancel_Click"/>
                <Button DockPanel.Dock="Right" Content="{core:T main.progress.hide}" Click="Hide_Click" IsCancel="True"/>
            </DockPanel>
            <CheckBox x:Name="AutoClose" Content="{core:T main.progress.autoClose}" Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</Window>
