<Window x:Class="Golan.Gdm.UI.HashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v4="clr-namespace:Golan.Gdm.Core"
        Title="{v4:T hash.win.title}" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Style="{StaticResource GdmWindow}" Icon="/Assets/gdm.ico">
    <StackPanel Margin="24">
        <TextBlock Text="{v4:T hash.win.title}" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="{v4:T hash.win.subtitle}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,16"/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{v4:T hash.win.file}" Style="{StaticResource Label}"/>
                <TextBlock x:Name="FileNameText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                <ProgressBar x:Name="HashProgress" Minimum="0" Maximum="100" Height="8" Margin="0,0,0,6"/>
                <TextBlock x:Name="StatusLabel" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,12"/>

                <!-- MD5 -->
                <TextBlock Text="MD5" Style="{StaticResource Label}"/>
                <DockPanel Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="{v4:T hash.win.copy}" Tag="MD5" Click="Copy_Click" Margin="8,0,0,0" Padding="14,5"/>
                    <TextBox x:Name="Md5Box" IsReadOnly="True" FlowDirection="LeftToRight" FontFamily="Consolas"/>
                </DockPanel>

                <!-- SHA-1 -->
                <TextBlock Text="SHA-1" Style="{StaticResource Label}"/>
                <DockPanel Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="{v4:T hash.win.copy}" Tag="SHA1" Click="Copy_Click" Margin="8,0,0,0" Padding="14,5"/>
                    <TextBox x:Name="Sha1Box" IsReadOnly="True" FlowDirection="LeftToRight" FontFamily="Consolas"/>
                </DockPanel>

                <!-- SHA-256 -->
                <TextBlock Text="SHA-256" Style="{StaticResource Label}"/>
                <DockPanel Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="{v4:T hash.win.copy}" Tag="SHA256" Click="Copy_Click" Margin="8,0,0,0" Padding="14,5"/>
                    <TextBox x:Name="Sha256Box" IsReadOnly="True" FlowDirection="LeftToRight" FontFamily="Consolas" TextWrapping="Wrap"/>
                </DockPanel>

                <!-- SHA-512 -->
                <TextBlock Text="SHA-512" Style="{StaticResource Label}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{v4:T hash.win.copy}" Tag="SHA512" Click="Copy_Click" Margin="8,0,0,0" Padding="14,5"/>
                    <TextBox x:Name="Sha512Box" IsReadOnly="True" FlowDirection="LeftToRight" FontFamily="Consolas" TextWrapping="Wrap"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="{v4:T hash.win.compare_label}" Style="{StaticResource Label}"/>
                <TextBox x:Name="CompareBox" FlowDirection="LeftToRight" FontFamily="Consolas"
                         Tag="{v4:T hash.win.compare_placeholder}" TextChanged="CompareBox_TextChanged"/>
                <TextBlock x:Name="CompareResultText" FontWeight="SemiBold" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,18,0,0">
            <Button Content="{v4:T hash.win.close}" Style="{StaticResource Primary}" IsDefault="True" IsCancel="True" Click="Close_Click" MinWidth="100"/>
        </StackPanel>
    </StackPanel>
</Window>
