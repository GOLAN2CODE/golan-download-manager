<Window x:Class="Golan.Gdm.UI.SpeedRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v4="clr-namespace:Golan.Gdm.Core"
        Title="{v4:T speedrules.win.title}" Width="760" Height="460" MinWidth="640" MinHeight="380"
        WindowStartupLocation="CenterOwner" Style="{StaticResource GdmWindow}" Icon="/Assets/gdm.ico">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{v4:T speedrules.win.title}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{v4:T speedrules.win.subtitle}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{v4:T speedrules.win.add}" Click="Add_Click" Margin="0,0,6,0" Padding="14,6"/>
                <Button Content="{v4:T speedrules.win.move_up}" Click="MoveUp_Click" Margin="0,0,6,0" Padding="14,6"/>
                <Button Content="{v4:T speedrules.win.move_down}" Click="MoveDown_Click" Margin="0,0,6,0" Padding="14,6"/>
                <Button Content="{v4:T speedrules.win.delete}" Click="Delete_Click" Padding="14,6"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="{v4:T speedrules.win.save}" Style="{StaticResource Primary}" IsDefault="True" Click="Save_Click" MinWidth="100"/>
                <Button Content="{v4:T speedrules.win.cancel}" IsCancel="True" Click="Cancel_Click" Margin="8,0,0,0" MinWidth="90"/>
            </StackPanel>
        </DockPanel>

        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="RulesGrid" IsReadOnly="False" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="{v4:T speedrules.win.col.enabled}" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                    <DataGridComboBoxColumn x:Name="DaysColumn" Header="{v4:T speedrules.win.col.days}"
                                            SelectedValueBinding="{Binding DaysPreset, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Key" DisplayMemberPath="Label" Width="180"/>
                    <DataGridTextColumn Header="{v4:T speedrules.win.col.from}" Binding="{Binding FromText, UpdateSourceTrigger=LostFocus}" Width="120"/>
                    <DataGridTextColumn Header="{v4:T speedrules.win.col.to}" Binding="{Binding ToText, UpdateSourceTrigger=LostFocus}" Width="120"/>
                    <DataGridTextColumn Header="{v4:T speedrules.win.col.limit}" Binding="{Binding LimitKBps, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
