<Window x:Class="Golan.Gdm.UI.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v4="clr-namespace:Golan.Gdm.Core"
        Title="{v4:T stats.win.title}" Width="860" Height="620" MinWidth="740" MinHeight="520"
        WindowStartupLocation="CenterOwner" Style="{StaticResource GdmWindow}" Icon="/Assets/gdm.ico">
    <DockPanel Margin="24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="BtnToday" Style="{StaticResource Chip}" Content="{v4:T stats.win.range.today}" Tag="Today" Click="Range_Click" Margin="0,0,6,0"/>
                <ToggleButton x:Name="Btn7Days" Style="{StaticResource Chip}" Content="{v4:T stats.win.range.days7}" Tag="Last7Days" Click="Range_Click" Margin="0,0,6,0"/>
                <ToggleButton x:Name="Btn30Days" Style="{StaticResource Chip}" Content="{v4:T stats.win.range.days30}" Tag="Last30Days" Click="Range_Click" IsChecked="True" Margin="0,0,6,0"/>
                <ToggleButton x:Name="BtnAll" Style="{StaticResource Chip}" Content="{v4:T stats.win.range.all}" Tag="AllTime" Click="Range_Click"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{v4:T stats.win.title}" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="{v4:T stats.win.subtitle}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,12,0"/>
            </StackPanel>
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="{v4:T stats.win.close}" Style="{StaticResource Primary}" IsDefault="True" IsCancel="True" Click="Close_Click" MinWidth="100"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="170"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Summary Cards -->
            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,12">
                <Border Style="{StaticResource Card}" Margin="0,0,6,0" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="{v4:T stats.win.card.bytes}" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="TotalBytesText" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,6,0" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="{v4:T stats.win.card.files}" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="TotalFilesText" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,6,0" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="{v4:T stats.win.card.avg_speed}" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="AvgSpeedText" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,0,0" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="{v4:T stats.win.card.active_time}" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="ActiveTimeText" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Daily Bar Chart -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{v4:T stats.win.section.daily}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="DailyBarsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="44" Margin="3,0" VerticalAlignment="Bottom" ToolTip="{Binding Tooltip}">
                                        <Border Height="{Binding BarHeight}" Width="22" CornerRadius="4,4,0,0"
                                                Background="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource Muted}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" FlowDirection="LeftToRight"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- By Category & Top Hosts -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{v4:T stats.win.section.categories}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <DataGrid x:Name="CategoriesGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{v4:T stats.win.col.name}" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="{v4:T stats.win.col.size}" Binding="{Binding SizeText}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{v4:T stats.win.section.hosts}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <DataGrid x:Name="HostsGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{v4:T stats.win.col.name}" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="{v4:T stats.win.col.size}" Binding="{Binding SizeText}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
