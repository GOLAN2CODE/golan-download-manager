<Window x:Class="Golan.Gdm.UI.RemoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Golan.Gdm.Core"
        Title="{core:TExtension remote.title}" Height="680" Width="820"
        WindowStartupLocation="CenterOwner" Style="{StaticResource GdmWindow}"
        Icon="/Assets/gdm.ico">
    <DockPanel>
        <!-- Bottom bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="{core:TExtension remote.close}" Padding="22,8" Click="Close_Click" IsCancel="True"/>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Foreground="{DynamicResource Muted}" FontWeight="SemiBold" FontSize="12.5"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>
                <TextBlock Text="{core:TExtension remote.subtitle}" Foreground="{DynamicResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                <!-- Top Grid: Server settings + QR & PIN pairing -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Server configuration card -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <CheckBox x:Name="EnableCheck" Content="{core:TExtension remote.enable}" FontWeight="SemiBold" Margin="0,0,0,14"/>

                            <TextBlock Text="{core:TExtension remote.interface}" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="InterfaceCombo" FlowDirection="LeftToRight" Margin="0,0,0,12"/>

                            <TextBlock Text="{core:TExtension remote.port}" Style="{StaticResource Label}"/>
                            <TextBox x:Name="PortBox" Width="120" HorizontalAlignment="Left" FlowDirection="LeftToRight" Margin="0,0,0,12"/>

                            <TextBox x:Name="UrlBox" IsReadOnly="True" FlowDirection="LeftToRight" FontWeight="SemiBold" Margin="0,0,0,10"/>

                            <TextBlock x:Name="CertFpTitleText" Style="{StaticResource Label}"/>
                            <TextBox x:Name="CertFpBox" IsReadOnly="True" FlowDirection="LeftToRight" FontFamily="Consolas"
                                     FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button x:Name="CopyFpBtn" Padding="10,4" Margin="0,0,8,0" Click="CopyFp_Click"/>
                                <Button x:Name="RegenerateCertBtn" Padding="10,4" Click="RegenerateCert_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="CertHintText" Foreground="{DynamicResource Muted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <Button x:Name="ApplyBtn" Style="{StaticResource Primary}" Content="{core:TExtension remote.apply}"
                                    HorizontalAlignment="Left" Padding="18,8" Click="Apply_Click"/>

                            <TextBlock Text="{core:TExtension remote.firewall_note}" Foreground="{DynamicResource Muted}"
                                       FontSize="11.5" TextWrapping="Wrap" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- QR Code + 6-digit PIN card -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{core:TExtension remote.pair.header}" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center" Margin="0,0,0,10"/>

                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="8"
                                    Background="{DynamicResource QrQuietZone}" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Image x:Name="QrImage" Width="168" Height="168" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>

                            <TextBlock Text="{core:TExtension remote.pair.qr_hint}" Foreground="{DynamicResource Muted}"
                                       FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/>

                            <TextBlock Text="{core:TExtension remote.pair.pin_label}" Foreground="{DynamicResource Muted}"
                                       FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="PinText" Text="{core:TExtension remote.pair.pin_none}" FontSize="26" FontWeight="Bold"
                                       FlowDirection="LeftToRight" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                            <TextBlock x:Name="PinExpiryText" Foreground="{DynamicResource Muted}" FontSize="11.5"
                                       HorizontalAlignment="Center" Margin="0,0,0,10"/>

                            <Button x:Name="GeneratePinBtn" Style="{StaticResource Primary}" Content="{core:TExtension remote.pair.generate_pin}"
                                    Padding="16,7" HorizontalAlignment="Center" Click="GeneratePin_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Paired devices card -->
                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="{core:TExtension remote.devices.header}" FontWeight="Bold"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <Button x:Name="RevokeAllBtn" DockPanel.Dock="Right" Content="{core:TExtension remote.devices.revoke_all}"
                                    Padding="12,5" Click="RevokeAll_Click"/>
                            <Button x:Name="RevokeSelectedBtn" DockPanel.Dock="Right" Content="{core:TExtension remote.devices.revoke}"
                                    Padding="12,5" Margin="0,0,8,0" Click="RevokeSelected_Click"/>
                        </DockPanel>

                        <DataGrid x:Name="DevicesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  MinHeight="130" MaxHeight="200" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                                  Background="{DynamicResource Surface}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{core:TExtension remote.devices.col.name}" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="{core:TExtension remote.devices.col.created}" Binding="{Binding CreatedAtText}" Width="1.5*"/>
                                <DataGridTextColumn Header="{core:TExtension remote.devices.col.last_seen}" Binding="{Binding LastSeenAtText}" Width="1.5*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
