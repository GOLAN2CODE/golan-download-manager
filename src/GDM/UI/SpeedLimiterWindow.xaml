<Window x:Class="Golan.Gdm.UI.SpeedLimiterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Golan.Gdm.Core"
        Title="{core:T win.limiter.title}" Width="520" SizeToContent="Height" MinHeight="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Style="{StaticResource GdmWindow}" Icon="/Assets/gdm.ico">
    <DockPanel>
        <StackPanel Margin="24">
            <TextBlock Text="{core:T win.limiter.title}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{core:T win.limiter.subtitle}" Foreground="{DynamicResource Muted}" Margin="0,4,0,18"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="EnabledBox" Content="{core:T win.limiter.enable}" Checked="EnabledChanged" Unchecked="EnabledChanged"/>
                    <DockPanel Margin="0,12,0,0">
                        <TextBox x:Name="SpeedBox" Width="100" FlowDirection="LeftToRight" HorizontalAlignment="Left" TextChanged="SpeedBox_TextChanged"
                                 AutomationProperties.Name="{core:T win.limiter.speed_aria}"/>
                        <TextBlock Text="{core:T win.limiter.kbs}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock x:Name="SpeedText" HorizontalAlignment="Right" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold"/>
                    </DockPanel>
                    <Slider x:Name="SpeedSlider" Minimum="16" Maximum="102400" TickFrequency="16" IsSnapToTickEnabled="True"
                            ValueChanged="SpeedSlider_ValueChanged" Margin="0,12,0,0"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="{core:T win.limiter.preset_256k}" Tag="256" Click="Preset_Click" Padding="10,5"/>
                        <Button Content="{core:T win.limiter.preset_512k}" Tag="512" Click="Preset_Click" Padding="10,5" Margin="6,0,0,0"/>
                        <Button Content="{core:T win.limiter.preset_1m}" Tag="1024" Click="Preset_Click" Padding="10,5" Margin="6,0,0,0"/>
                        <Button Content="{core:T win.limiter.preset_2m}" Tag="2048" Click="Preset_Click" Padding="10,5" Margin="6,0,0,0"/>
                        <Button Content="{core:T win.limiter.preset_5m}" Tag="5120" Click="Preset_Click" Padding="10,5" Margin="6,0,0,0"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <CheckBox x:Name="StartupBox" Content="{core:T win.limiter.startup}" Margin="0,14,0,0"/>
            <TextBlock Text="{core:T win.limiter.note}"
                       TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,18,0,0">
                <Button Content="{core:T win.limiter.ok}" Style="{StaticResource Primary}" IsDefault="True" Click="Ok_Click" Padding="20,7"/>
                <Button Content="{core:T win.limiter.cancel}" IsCancel="True" Click="Cancel_Click" Padding="20,7" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
