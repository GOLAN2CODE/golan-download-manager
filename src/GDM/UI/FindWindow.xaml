<Window x:Class="Golan.Gdm.UI.FindWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Golan.Gdm.Core"
        Title="{core:T win.find.title}" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" Style="{StaticResource GdmWindow}" Icon="/Assets/gdm.ico">
    <StackPanel Margin="20">
        <TextBlock Text="{core:T win.find.header}" FontSize="18" FontWeight="SemiBold"/>
        <TextBox x:Name="QueryBox" Margin="0,14,0,10" Tag="{core:T win.find.query_tag}"/>
        <TextBlock Text="{core:T win.find.search_in}" Style="{StaticResource Label}"/>
        <WrapPanel>
            <CheckBox x:Name="NameBox" Content="{core:T win.find.in_name}" IsChecked="True"/>
            <CheckBox x:Name="DescriptionBox" Content="{core:T win.find.in_desc}" IsChecked="True" Margin="14,5,0,0"/>
            <CheckBox x:Name="AddressBox" Content="{core:T win.find.in_address}" IsChecked="True" Margin="14,5,0,0"/>
        </WrapPanel>
        <CheckBox x:Name="CaseBox" Content="{core:T win.find.match_case}"/>
        <CheckBox x:Name="WholeBox" Content="{core:T win.find.whole_string}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
            <Button Content="{core:T win.find.find_btn}" Style="{StaticResource Primary}" IsDefault="True" Click="Find_Click"/>
            <Button Content="{core:T win.find.cancel}" IsCancel="True" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
