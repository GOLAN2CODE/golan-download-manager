<Window x:Class="Golan.Gdm.UI.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Golan.Gdm.Core"
        Title="{core:T win.options.title}" Width="860" Height="740" MinWidth="760"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Style="{StaticResource GdmWindow}" Icon="/Assets/gdm.ico">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="SaveBtn" Content="{core:T win.options.ok}" Style="{StaticResource Primary}" IsDefault="True"
                        IsEnabled="{Binding IsValid}" Click="Save_Click" Padding="24,8"/>
                <Button x:Name="CancelBtn" Content="{core:T win.options.cancel}" IsCancel="True" Click="Cancel_Click"
                        Margin="8,0,0,0" Padding="20,8"/>
            </StackPanel>
        </Border>
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{core:T win.options.header}" FontSize="18"
                               FontWeight="SemiBold" Margin="8,4,8,14"/>
                    <ListBox x:Name="NavList" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource NavItem}"
                             SelectionChanged="NavList_SelectionChanged"
                             AutomationProperties.Name="{core:T win.options.nav_aria}"/>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <ScrollViewer x:Name="PageScroll" Padding="20"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ContentControl x:Name="PageHost"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
