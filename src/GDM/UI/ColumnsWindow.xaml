<Window x:Class="Golan.Gdm.UI.ColumnsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Golan.Gdm.Core"
        Title="{core:T win.columns.title}" Width="480" Height="500"
        WindowStartupLocation="CenterOwner" Style="{StaticResource GdmWindow}" Icon="/Assets/gdm.ico">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
            <Button Content="{core:T win.columns.ok}" Style="{StaticResource Primary}" IsDefault="True" Click="Ok_Click"/>
            <Button Content="{core:T win.columns.cancel}" IsCancel="True" Margin="8,0,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Width="145" Margin="12,0,0,0">
            <Button Content="{core:T win.columns.up}" Click="Up_Click"/>
            <Button Content="{core:T win.columns.down}" Margin="0,6,0,0" Click="Down_Click"/>
            <Button Content="{core:T win.columns.show}" Margin="0,18,0,0" Click="Show_Click"/>
            <Button Content="{core:T win.columns.hide}" Margin="0,6,0,0" Click="Hide_Click"/>
            <Button Content="{core:T win.columns.default}" Margin="0,18,0,0" Click="Default_Click"/>
            <TextBlock Text="{core:T win.columns.width_px}" Style="{StaticResource Label}" Margin="0,18,0,4"/>
            <TextBox x:Name="WidthBox" FlowDirection="LeftToRight" TextChanged="Width_Changed"/>
        </StackPanel>
        <ListBox x:Name="ColumnsList" SelectionChanged="Selection_Changed"/>
    </DockPanel>
</Window>
