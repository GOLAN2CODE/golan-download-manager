<Window x:Class="Golan.Gdm.UI.TorrentFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v3="clr-namespace:Golan.Gdm.Core"
        Title="{v3:T torrent.files.title}" Width="980" Height="560" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" Style="{StaticResource GdmWindow}" Icon="/Assets/gdm.ico">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="TorrentNameText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{v3:T torrent.files.subtitle}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/>
        </StackPanel>

        <Border x:Name="ExeWarningBanner" Grid.Row="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10"
                Background="{DynamicResource AccentSoft}" Visibility="Collapsed">
            <TextBlock Text="{v3:T torrent.files.exeWarning}" Foreground="{DynamicResource Warning}"
                       TextWrapping="Wrap" FontWeight="SemiBold"/>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,0,0,10" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="{v3:T torrent.files.selectAll}" Click="SelectAll_Click" Margin="0,0,8,0"/>
            <Button DockPanel.Dock="Left" Content="{v3:T torrent.files.selectNone}" Click="SelectNone_Click" Margin="0,0,16,0"/>
            <CheckBox x:Name="SequentialCheck" DockPanel.Dock="Left" Content="{v3:T torrent.files.sequential}"
                      VerticalAlignment="Center"/>
            <TextBlock x:Name="SummaryText" DockPanel.Dock="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource Muted}" FontWeight="SemiBold"/>
        </DockPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" MinWidth="140"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{v3:T torrent.files.foldersHeader}"
                               FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="4,2,4,6"/>
                    <TreeView x:Name="FolderTree" BorderThickness="0" Background="Transparent"
                              SelectedItemChanged="FolderTree_SelectedItemChanged"/>
                </DockPanel>
            </Border>

            <DataGrid x:Name="FilesGrid" Grid.Column="2" AutoGenerateColumns="False" IsReadOnly="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="{v3:T torrent.files.col.selected}"
                                            Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"
                                            Width="78"/>
                    <DataGridTextColumn Header="{v3:T torrent.files.col.path}"
                                        Binding="{Binding Path}" IsReadOnly="True" Width="4.2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="{v3:T torrent.files.col.size}"
                                        Binding="{Binding SizeText}" IsReadOnly="True" Width="105"/>
                    <DataGridComboBoxColumn x:Name="PriorityColumn"
                                            Header="{v3:T torrent.files.col.priority}"
                                            SelectedValueBinding="{Binding Priority, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Value" DisplayMemberPath="Label" Width="125"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <DockPanel Grid.Row="4" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="{v3:T torrent.files.cancel}" Click="Cancel_Click" IsCancel="True" MinWidth="90" Margin="8,0,0,0"/>
            <Button x:Name="OkBtn" DockPanel.Dock="Right" Content="{v3:T torrent.files.ok}" Style="{StaticResource Primary}"
                    Click="Ok_Click" IsDefault="True" MinWidth="100"/>
        </DockPanel>
    </Grid>
</Window>
